# Application
NODE_ENV=development
PORT=3000

# Database (XAMPP default: user root, password kosong)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=opsinventory_db
DB_CONNECTION_LIMIT=10

# Session
SESSION_NAME=opsinv.sid
SESSION_SECRET=replace-with-at-least-32-char-random-string
SESSION_MAX_AGE_MS=86400000